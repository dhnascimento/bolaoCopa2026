# ── Supabase (required) ───────────────────────────────────────────────────────
# Public — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only — NEVER import from client components
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Football data (required) ──────────────────────────────────────────────────
# API-Football (api-sports.io) key — free tier: 100 req/day
API_FOOTBALL_KEY=<api-football-key>

# ── Email reminders (required for send-reminders Edge Function) ───────────────
# Resend API key — https://resend.com
RESEND_API_KEY=<resend-api-key>
# Verified sender address/domain, e.g. "Bolão Copa 2026 <noreply@yourdomain.com>"
RESEND_FROM=Bolão Copa 2026 <noreply@yourdomain.com>
# Public app URL (used in reminder email links)
APP_URL=https://yourdomain.com

# ── OAuth — Google (optional, enables Google sign-in) ────────────────────────
# Create credentials at console.cloud.google.com
# Redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<google-client-id>
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<google-client-secret>

# ── Cron security (optional but recommended) ──────────────────────────────────
# Random secret shared between Supabase pg_cron and Edge Functions.
# Set via: supabase secrets set CRON_SECRET=<value>
# Also set in Postgres: ALTER DATABASE postgres SET app.cron_secret = '<value>';
CRON_SECRET=<random-secret>
